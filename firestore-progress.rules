    match /progress/{id} {
      allow get: if id.matches('^[0-9a-f]{32}$');
      allow list, delete: if false;
      allow create, update: if id.matches('^[0-9a-f]{32}$')
        && request.resource.data.keys().hasOnly(['v', 'name', 'grade', 'track', 'g', 'data', 'at'])
        && request.resource.data.keys().hasAll(['v', 'name', 'grade', 'track', 'data', 'at'])
        && request.resource.data.v is int
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 20
        && request.resource.data.grade is string
        && request.resource.data.grade.size() <= 4
        && request.resource.data.track is string
        && request.resource.data.track.size() <= 4
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 400000
        && request.resource.data.at == request.time;
    }
