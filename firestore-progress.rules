rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'ahmadtahoon2020@gmail.com'
        && request.auth.token.email_verified == true;
    }
    match /feedback/{id} {
      allow read, delete: if isOwner();
      allow create, update: if isOwner() || (
        request.resource.data.keys().hasOnly(['rating','label','text','wants','chapter','grade','track','name','from','at'])
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.text is string && request.resource.data.text.size() <= 120
        && (!('wants' in request.resource.data) || (request.resource.data.wants is string && request.resource.data.wants.size() <= 80))
        && request.resource.data.name is string && request.resource.data.name.size() <= 14
        && request.resource.data.at == request.time
      );
    }
    match /messages/{id} {
      allow read, delete: if isOwner();
      allow create: if
        request.resource.data.keys().hasOnly(['name','role','contact','text','at'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 40
        && request.resource.data.role in ['parent','teacher','other']
        && request.resource.data.contact is string && request.resource.data.contact.size() <= 80
        && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 800
        && request.resource.data.at == request.time;
    }
    match /showcase/{id} {
      allow read: if true;
      allow write: if isOwner();
    }
    match /boards/{board}/scores/{player} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'score', 'at'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 14
        && request.resource.data.score is int
        && request.resource.data.score >= 0 && request.resource.data.score <= 100000
        && request.resource.data.at == request.time;
      allow update: if request.resource.data.keys().hasOnly(['name', 'score', 'at'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 14
        && request.resource.data.score is int
        && request.resource.data.score >= 0 && request.resource.data.score <= 100000
        && request.resource.data.at == request.time
        && request.resource.data.score > resource.data.score;
      allow delete: if false;
    }
    match /grades/{grade}/scores/{player} {
      allow read: if true;
      allow create: if grade.matches('^(g[1-6]|p[1-3])$')
        && request.resource.data.keys().hasOnly(['name', 'score', 'at'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 14
        && request.resource.data.score is int
        && request.resource.data.score >= 0 && request.resource.data.score <= 100000
        && request.resource.data.at == request.time;
      allow update: if grade.matches('^(g[1-6]|p[1-3])$')
        && request.resource.data.keys().hasOnly(['name', 'score', 'at'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 14
        && request.resource.data.score is int
        && request.resource.data.score >= 0 && request.resource.data.score <= 100000
        && request.resource.data.at == request.time
        && request.resource.data.score > resource.data.score;
      allow delete: if false;
    }
    match /weeks/{week}/scores/{player} {
      allow read: if true;
      allow create: if week.matches('^20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]$')
        && request.resource.data.keys().hasOnly(['name', 'score', 'at'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 14
        && request.resource.data.score is int
        && request.resource.data.score >= 0 && request.resource.data.score <= 100000
        && request.resource.data.at == request.time;
      allow update: if week.matches('^20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]$')
        && request.resource.data.keys().hasOnly(['name', 'score', 'at'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 14
        && request.resource.data.score is int
        && request.resource.data.score >= 0 && request.resource.data.score <= 100000
        && request.resource.data.at == request.time
        && request.resource.data.score > resource.data.score;
      allow delete: if false;
    }
    match /wgrades/{wk}/scores/{player} {
      allow read: if true;
      allow create: if wk.matches('^20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]_(g[1-6]|p[1-3])$')
        && request.resource.data.keys().hasOnly(['name', 'score', 'at'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 14
        && request.resource.data.score is int
        && request.resource.data.score >= 0 && request.resource.data.score <= 100000
        && request.resource.data.at == request.time;
      allow update: if wk.matches('^20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]_(g[1-6]|p[1-3])$')
        && request.resource.data.keys().hasOnly(['name', 'score', 'at'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 14
        && request.resource.data.score is int
        && request.resource.data.score >= 0 && request.resource.data.score <= 100000
        && request.resource.data.at == request.time
        && request.resource.data.score > resource.data.score;
      allow delete: if false;
    }
    match /cards/{player} {
      allow read: if true;
      allow delete: if false;
      allow create, update: if request.resource.data.keys().hasOnly(['name', 'grade', 'g', 'streak', 'lvl', 'bdg', 'at'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 14
        && request.resource.data.grade is string && request.resource.data.grade.size() <= 4
        && request.resource.data.g in ['m', 'f']
        && request.resource.data.streak is int
        && request.resource.data.streak >= 0 && request.resource.data.streak <= 10000
        && request.resource.data.lvl is int
        && request.resource.data.lvl >= 1 && request.resource.data.lvl <= 10
        && request.resource.data.bdg is string && request.resource.data.bdg.size() <= 80
        && request.resource.data.at == request.time;
    }
    match /photos/{player} {
      allow get: if isOwner() || resource.data.status in ['ok', 'no'];
      allow list, delete: if isOwner();
      allow create, update: if isOwner() || (
        request.resource.data.keys().hasOnly(['name', 'data', 'status', 'at'])
        && request.resource.data.status == 'pending'
        && request.resource.data.name is string && request.resource.data.name.size() <= 14
        && request.resource.data.data is string && request.resource.data.data.size() <= 60000
        && request.resource.data.at == request.time
      );
    }
    match /progress/{id} {
      allow get: if id.matches('^[0-9a-f]{32}$');
      allow list: if isOwner();
      allow delete: if false;
      allow create, update: if id.matches('^[0-9a-f]{32}$')
        && request.resource.data.keys().hasOnly(['v', 'name', 'grade', 'track', 'g', 'data', 'at'])
        && request.resource.data.keys().hasAll(['v', 'name', 'grade', 'track', 'data', 'at'])
        && request.resource.data.v is int
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 20
        && request.resource.data.grade is string
        && request.resource.data.grade.size() <= 4
        && request.resource.data.track is string
        && request.resource.data.track.size() <= 4
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 400000
        && request.resource.data.at == request.time;
    }
  }
}
